# Schematic needs no .env file to run.
#
# API keys are typed into the UI and stored in your browser's localStorage only.
# They are sent per-request to the local backend, which uses them for a single
# outbound fetch and never writes them anywhere. No key is ever committed.

# Optional: override the backend port (default 3001).
# PORT=3001

# Optional: per-request timeout in milliseconds (default 240000 — local models are slow).
# SCHEMATIC_TIMEOUT_MS=240000

# The variables below are read ONLY by the test suite's mock provider.
# They are never used by the app itself.
# MOCK_PARTICLE_PORT=11435